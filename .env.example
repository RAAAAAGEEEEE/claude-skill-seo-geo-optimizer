# seo-geo-optimizer -- variables d'environnement (toutes optionnelles).
# Copier hors du dépôt (ex. ~/secrets/seo-audit.env, droits 600), remplir,
# puis charger avant run_audit.py :  set -a; . ~/secrets/seo-audit.env; set +a
# Ne jamais commiter ce fichier rempli. Détail : docs/CONFIGURATION.md

# Clé API Google Cloud avec "PageSpeed Insights API" activée (labo + terrain).
PAGESPEED_API_KEY=

# Clé API Google Cloud avec "Chrome UX Report API" activée. Vide = PAGESPEED_API_KEY est réutilisée.
CRUX_API_KEY=

# Chemin vers le fichier JSON du compte de service Search Console (lecture seule).
GSC_SERVICE_ACCOUNT_FILE=
# Propriété Search Console, ex. sc-domain:example.com (ou --gsc-site).
GSC_SITE=

# Clé IndexNow du site (fichier /<clé>.txt publié à la racine). Un site par variable :
# INDEXNOW_KEY_ACME=... puis run_audit.py --indexnow-key-env INDEXNOW_KEY_ACME
INDEXNOW_KEY=
